# ==============================================================================
# NYAYASETU BACKEND CONFIGURATION
# Copy this file to .env and adjust variables for your local or production environment.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_NAME=NyayaSetu Backend API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Server Bindings
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated URLs or wildcard *)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Database Configuration
# Local development defaults to a zero-setup SQLite file: the API creates
# `backend/nyayasetu.db` and its tables automatically on startup.
# For PostgreSQL 16 (PostGIS + pgvector), use the URLs in the comments below
# and run `alembic upgrade head`. Supabase pooler format:
# postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite+aiosqlite:///./nyayasetu.db
DATABASE_URL_SYNC=sqlite:///./nyayasetu.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nyayasetu
# DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5432/nyayasetu

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Supabase Credentials
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_AghcSMNgQd1JlABKevbIGA_wROA32fu

# AI & Legal Embeddings Configuration
# AI Provider: 'gemini' for live Google GenAI integration, 'mock' for local deterministic offline testing
# Set AI_PROVIDER=groq and add the backend-only key to enable live chat.
AI_PROVIDER=mock
GROQ_API_KEY=
GROQ_LLM_MODEL=qwen/qwen3.8-27b
# Generation budget and retry policy. Defaults are conservative for on-demand
# quotas (1000 output tokens/minute); raise them only to match your actual tier.
GROQ_MAX_COMPLETION_TOKENS=800
GROQ_REQUEST_TIMEOUT_SECONDS=20.0
GROQ_MAX_RETRIES=2
GROQ_RETRY_BACKOFF_SECONDS=2.0
GROQ_RETRY_JITTER_SECONDS=1.0
GROQ_OUTPUT_TOKEN_BUDGET_PER_MINUTE=15000
GROQ_OUTPUT_BUDGET_WINDOW_SECONDS=60.0
GROQ_MAX_CONTEXT_CHUNKS=5
GROQ_MAX_CONTEXT_CHARS=8000
GROQ_MAX_CHUNK_CHARS=1400
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_MAX_COMPLETION_TOKENS=800
GEMINI_REQUEST_TIMEOUT_SECONDS=20.0
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BACKOFF_SECONDS=1.0
EMBEDDING_VECTOR_DIMENSION=768

# Grounded RAG retrieval and acquisition (all optional / opt-in)
# Official-source fetching is disabled by default. Enable only after an operator
# verifies the source terms of use and runs `python scripts/rag_ops.py verify`.
RAG_SOURCE_FETCH_ENABLED=false
LEGAL_SOURCE_REGISTRY_CSV=
RAG_FETCH_TIMEOUT_SECONDS=15.0
RAG_FETCH_MAX_BYTES=12582912
RAG_FETCH_MAX_RETRIES=2
RAG_FETCH_RETRY_BACKOFF_SECONDS=1.0
RAG_FETCH_ALLOWED_CONTENT_TYPES=application/pdf,text/html,text/plain,application/xml,text/xml,application/xhtml+xml,application/octet-stream
RAG_FETCH_USER_AGENT=NyayaSetuLegalResearch/1.0 (+https://nyayasetu.in)
RAG_SYNC_CONCURRENCY=2
RAG_DISCOVERY_MAX_DOCUMENTS=50

# Neural embeddings are opt-in. Requires `sentence-transformers` and a model
# whose output dimension matches EMBEDDING_VECTOR_DIMENSION; reindex when changed.
RAG_NEURAL_EMBEDDING_ENABLED=false
RAG_NEURAL_EMBEDDING_DEVICE=
RAG_EMBEDDING_CACHE_SIZE=512

# Evidence gates, fallback, and observability
RAG_OFFICIAL_FALLBACK_ENABLED=false
RAG_EVIDENCE_MIN_SCORE=0.45
RAG_EVIDENCE_MIN_CHUNKS=1
RAG_CLAIM_SUPPORT_MIN_RATIO=0.5
RAG_ABSTAIN_WITHOUT_CITATIONS=true
RAG_OBSERVABILITY_ENABLED=true
# Optional local JSONL sink for content-free operational events.
RAG_OBSERVABILITY_LOG_PATH=

# Document Vault Storage Configuration (Cloudflare R2 / S3-Compatible)
# Read exclusively from environment variables:
# STORAGE_PROVIDER: "local" (default for offline dev & automated tests) or "r2" (production)
STORAGE_PROVIDER=local
STORAGE_BUCKET=nyayasetu-vault-production
STORAGE_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=your_r2_access_key_id_placeholder
STORAGE_SECRET_ACCESS_KEY=your_r2_secret_access_key_placeholder

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security & Tokens
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Advocate Matching Engine Configurable Factor Weights (Must sum to 1.0)
MATCHING_WEIGHT_PRACTICE=0.35
MATCHING_WEIGHT_JURISDICTION=0.25
MATCHING_WEIGHT_LANGUAGE=0.20
MATCHING_WEIGHT_PROXIMITY=0.10
MATCHING_WEIGHT_AVAILABILITY=0.10
